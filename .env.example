# ====================================================================
# Pilihan Mode Database (DATA_MODE):
# - real   : Cloud Firestore Google (Default produksi / online)
# - mysql  : MySQL Lokal (Laragon / XAMPP di PC ini)
# - mock   : Mock memory sementara
# ====================================================================
# DATA_MODE=mysql

# Konfigurasi Koneksi MySQL (Laragon / PC Lokal)
# Default Laragon adalah host 127.0.0.1, port 3306, user root, password kosong
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=absen_miful

# Opsional: kunci tambahan untuk hash token sesi
# SESSION_SECRET=
